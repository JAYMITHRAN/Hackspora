# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/apps/*/node_modules
/services/*/.venv

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*
/apps/*/.env
/apps/*/.env.*
/services/*/.env

# next.js
/apps/frontend/.next/
/apps/frontend/out/

# production
/apps/backend/dist
/apps/backend/build

# vercel
.vercel

# typescript
*.tsbuildinfo
/apps/frontend/next-env.d.ts